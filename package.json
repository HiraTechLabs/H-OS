{
  "name": "h-os",
  "version": "0.0.0",
  "private": true,
  "description": "H-OS — integrated business operating system. Modular monolith.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @h-os/kernel db:generate && pnpm --filter @h-os/hr-api db:generate",
    "db:migrate": "pnpm --filter @h-os/kernel db:migrate && pnpm --filter @h-os/hr-api db:migrate",
    "db:seed": "pnpm --filter @h-os/api db:seed",
    "graph:generate": "node tools/graph/generate.mjs",
    "graph:check": "node tools/graph/generate.mjs --check",
    "principles:check": "node tools/principles/validate.mjs",
    "arch:check": "node tools/arch/check.mjs",
    "governance": "pnpm graph:check && pnpm principles:check && pnpm arch:check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm governance"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
