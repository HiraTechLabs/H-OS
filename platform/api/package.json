{
  "name": "@h-os/api",
  "version": "0.0.0",
  "private": true,
  "description": "H-OS composition root: HTTP API, authentication endpoints, platform bootstrap.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "db:seed": "node ./dist/bootstrap/seed-cli.js"
  },
  "dependencies": {
    "@h-os/contracts": "workspace:*",
    "@h-os/hr-api": "workspace:*",
    "@h-os/kernel": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "postgres": "3.4.9",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
