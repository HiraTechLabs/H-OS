{
  "name": "@h-os/hr-api",
  "version": "0.0.0",
  "private": true,
  "description": "H-HR backend module: employee records, organization, employment lifecycle, effective-dated assignments.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./scripts/migrate.mjs"
  },
  "dependencies": {
    "@h-os/contracts": "workspace:*",
    "@h-os/kernel": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.9",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
