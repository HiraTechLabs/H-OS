# H-OS runtime configuration. Copy to `.env` and fill in. Never commit `.env`.
# Validated at boot by backend/cmd/server; the process fails fast when a value is missing (STK-003).

APP_ENV=development
PORT=3000
# RFC 9457 problem+json `type` base URI
API_BASE_URL=http://localhost:3000/api/v1

# PostgreSQL. Extensions ltree, btree_gist, pgcrypto must be available.
# The Compose service publishes 5433 on the host so it never collides with a locally
# installed PostgreSQL on the default port 5432.
DATABASE_URL=postgres://h_os:h_os@localhost:5433/h_os

# Comma-separated allowlist for CORS. Empty means "same origin only".
CORS_ORIGINS=http://localhost:5173

# Session cookie signing key, at least 32 characters. Generate per environment.
SESSION_SECRET=change-me-to-at-least-32-characters-long

// Session lifetime in minutes, and idle timeout in minutes.
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=120

# Failed sign-in attempts tolerated per source address per minute (SEC-011); per-account
# lockout (5 attempts / 15 min) applies regardless of this value.
LOGIN_RATE_LIMIT=20

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Bootstrap identity for the first administrator. Used only when the account table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@h-os.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis-Local-Dev-Only-1

# Single organization (BIZ-009 tenant-aware, single-tenant deployment).
ORGANIZATION_CODE=HOS
ORGANIZATION_NAME_EN=HiraTech Labs
ORGANIZATION_NAME_AR=هيرا تك لابس
ORGANIZATION_TIMEZONE=Asia/Riyadh

# AES-256-GCM key for national IDs, passports and bank identifiers (SEC-008).
# Exactly 32 bytes encoded as 64 hex characters or base64. Required in production;
# in development an ephemeral per-process key is used when this is empty, which makes
# encrypted values unreadable after a restart. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
